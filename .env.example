# このファイルを .env にコピーし、値を手で書く。.env は git 管理外。
# 鍵はパスワードマネージャーや他の環境変数から自動で探さない。無ければ処理は止まり、ここに書くべき変数名を表示する。
# 注意: このファイル（.env.example）には値を書かない。git にコミットされる。
ANTHROPIC_API_KEY=
# Google Maps Embed API（HTTP リファラで制限した公開キー）。無ければ地図は外部リンクにフォールバックする
GOOGLE_MAPS_EMBED_KEY=
# Cloudflare Pages へのデプロイ（CI で使う。手元では dry-run のみ）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare Web Analytics のビーコントークン（無ければ計測タグを出さない）
CF_WEB_ANALYTICS_TOKEN=
# Google Search Console のメタタグ方式トークン（無ければ出力しない。ファイル方式は verification/ に置く）
GOOGLE_SITE_VERIFICATION=
