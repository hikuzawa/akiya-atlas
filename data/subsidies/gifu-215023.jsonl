{"amount_text": "2万円から6万円", "checked_on": "2026-09-15", "first_seen_at": "2026-09-14T23:57:51+00:00", "history": [{"at": "2026-09-14T23:57:51+00:00", "event": "created"}], "kind": "移住", "kind_quote": null, "last_seen_at": "2026-09-14T23:57:51+00:00", "name": "町営住宅転入者支援補助金", "period_end": null, "period_text": "入居可能日から1か月以内", "provenance": {"content_hash": "sha256:fbf5ff039cf0bfef1c2ede0fd507c99e3c2b9a915093f3d693cb4c6bd865f8a3", "extractor": {"cached": false, "extracted_at": "2026-09-14T23:57:51Z", "input_tokens": 2851, "model": "claude-haiku-4-5-20251001", "output_tokens": 306, "prompt_version": "subsidy_v1", "provider": "anthropic"}, "fetched_at": "2026-09-14T23:57:34Z", "license": null, "page_kind": "subsidy", "source_url": "https://www.town.tomika.gifu.jp/docs/6967.html"}, "record_id": "eedfe25950e9bbfd", "scope": "空き家", "source_id": "gifu-215023", "status": "active", "summary": "町外から町営住宅に入居した人を対象に、世帯構成に応じて2万円から6万円の補助金を交付する制度。転入者数と中学生以下の子の人数により補助額が決まる。", "url": "https://www.town.tomika.gifu.jp/docs/6967.html", "year_text": null}
